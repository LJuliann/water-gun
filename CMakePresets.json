{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "pico2",
      "displayName": "Raspberry Pi Pico 2 (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "PICO_BOARD": "pico2",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "WATER_GUN_USE_UART_IRQ": "OFF",
        "WATER_GUN_DEBUG": "OFF"
      }
    },
    {
      "name": "pico2-uart-irq",
      "displayName": "Raspberry Pi Pico 2 (Debug, UART0 IRQ)",
      "inherits": "pico2",
      "cacheVariables": {
        "WATER_GUN_USE_UART_IRQ": "ON"
      }
    },
    {
      "name": "pico-usb",
      "displayName": "Raspberry Pi Pico (RP2040, USB CDC)",
      "inherits": "pico2",
      "binaryDir": "${sourceDir}/build-pico",
      "cacheVariables": {
        "PICO_BOARD": "pico",
        "WATER_GUN_STDIO_USB": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "pico2", "configurePreset": "pico2" },
    { "name": "pico2-uart-irq", "configurePreset": "pico2-uart-irq" },
    { "name": "pico-usb", "configurePreset": "pico-usb" }
  ]
}
